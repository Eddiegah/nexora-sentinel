# Not a secret -- NEXT_PUBLIC_* vars are inlined into the client bundle.
# Points at the Render backend service defined in render.yaml. If Render
# assigns a different URL (e.g. the name was taken and it appended a
# suffix), update this to match and redeploy, or override it in Vercel's
# project settings instead.
NEXT_PUBLIC_API_URL=https://nexora-sentinel-backend.onrender.com
